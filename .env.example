# Copy to .env. docker-compose reads DB_PORT; the app reads DATABASE_URL.
DB_PORT=5433
DATABASE_URL=postgres://dispatcher:dispatcher@localhost:5433/dispatcher

# Mock provider
PROVIDER_URL=http://localhost:4010
PROVIDER_PORT=4010
PROVIDER_TIMEOUT_MS=2000

# API
API_PORT=3100

# Rate limit applied to every tenant created by POST /campaigns (R6).
RATE_LIMIT_PER_SEC=50
